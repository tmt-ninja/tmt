    "shadow": {
      "$description": "One elevation scale (#5821): elevation-0 (page) to elevation-3 (modal). Surfaces pair a level with a hairline border, since dark themes show shadows weakly. overlay is elevation-2 for floating layers.",
      "elevation-0": {
        "dark": "0 0 #0000",
        "light": "0 0 #0000"
      },
      "elevation-1": {
        "light": "0 1px 2px #14141414",
        "dark": "0 1px 2px #00000059"
      },
      "elevation-2": {
        "light": "0 6px 16px #1414141f",
        "dark": "0 6px 16px #00000080"
      },
      "elevation-3": {
        "light": "0 16px 40px #1414141f",
        "dark": "0 16px 40px #00000080"
      },
