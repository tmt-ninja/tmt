      "use": "Terminal status and key bars",
      "dark": "#101118",
      "light": "#16161E"
    },
    "term-edge": {
      "use": "Pane borders inside mockups",
      "dark": "#292E42",
      "light": "#292E42"
    }
  },
  "font": {
    "display": {
      "use": "Headings",
      "stack": "Inter, -apple-system, system-ui, \"Segoe UI\", sans-serif"
    },
    "body": {
      "use": "Prose",
      "stack": "Inter, -apple-system, system-ui, \"Segoe UI\", sans-serif"
    },
    "mono": {
      "use": "Commands, labels, terminal mockups",
      "stack": "\"JetBrains Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
    }
  },
  "header": {
    "height": "62px",
    "compact-height": "56px",
    "compact-max-width": "760px",
    "padding-inline": "36px",
    "gap": "12px",
    "mark-size": "12px",
    "mark-line-height": "1",
    "mark-weight": "600",
    "wordmark-size": "14px",
    "wordmark-line-height": "1.2",
    "wordmark-weight": "600",
    "title-size": "16px",
    "title-line-height": "1.2",
    "title-weight": "600",
    "action-size": "13px",
    "action-line-height": "1.2",
    "action-weight": "400",
    "icon-size": "18px",
    "icon-stroke": "1.75",
    "compact-padding-inline": "18px"
  },
  "breakpoint": {
    "sm": {
      "use": "Narrow terminal: the smallest width a view must fit",
      "cells": 80
    },
    "md": {
      "use": "Medium terminal: a second optional step appears",
      "cells": 100
    },
    "lg": {
      "use": "Wide terminal: every optional part is shown",
      "cells": 140
    }
  },
  "mark": {
    "●": "running or active",
    "○": "offline or ended",
    "◌": "bound to a pane, no agent running",
    "◆": "waits on your decision",
    "!": "warning",
    "✗": "failed or blocked",
    "✓": "done",
    "◐": "in review, waiting on someone else (board only)",
    "↻": "leads a resume action, never a row's state",
    "✎": "an annotation you sent (board only)",
    "‹ ›": "tabs off the end of a line (board only)",
    "▸": "a folded Squad board pane (board only)",
    "▾": "an open foldable pane in a toggle hint (board only)",
    "≠": "differs from all boards (this squad overrides it; board only)",
    "~": "approximate observed token total from incomplete coverage (board only)",
    "≈": "estimate marker before a list-price quote (board only)",
    "▁▂▃▄▅▆▇█": "completed-request trend: ▁ measured zero, ▂–█ relative totals, blank no data (board only)",
    "⧉": "pasted-text attachment (board only; ASCII: [Pasted])",
    "×": "remove a pasted-text attachment (board only; ASCII: x)",
    "≡": "a conversation's Notes list and its summary chip (board only; the word Notes names it, so no ASCII form)",
    "↗": "a Notes link row, which opens its reference (board only; ASCII: >)"
  },
