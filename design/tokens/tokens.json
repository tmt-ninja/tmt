        "light": "0 6px 16px #1414141f",
        "dark": "0 6px 16px #00000080"
      }
    },
    "motion": {
      "$description": "Motion: two durations, two easings, the pop and slide distances and the calm skeleton pulse. Nothing scales on press: a shrinking control loses a click released near its edge. Under prefers-reduced-motion every duration (pulse included) is 0ms, so a change is instant.",
      "fast": "120ms",
      "base": "180ms",
      "ease-out": "cubic-bezier(0.2, 0, 0, 1)",
      "ease-in": "cubic-bezier(0.4, 0, 1, 1)",
      "scale": "0.96",
      "rise": "6px",
      "pulse": "1600ms"
    }
  },
  "unified": {
    "$comment": "The site's legacy --c-* roles resolve to the browser roles, so the site and every browser surface read one palette (#3937). A path ending in @dark is always the dark value: terminal mockups are dark in both themes.",
