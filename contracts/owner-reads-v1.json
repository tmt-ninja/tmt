    {
      "name": "savings: the Digest extension is absent",
      "target": "digest/savings/24h",
      "commands": {
        "digest decisions --report --since 24h --json": {
          "exit": 1,
          "stdout": {
            "error": {
              "code": "USAGE_ERROR",
