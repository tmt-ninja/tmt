{
  "description": "Marker cases for the page runtime's React (#1693, #6077): whether a page's HTML source asks for React. Every page gets Tailwind, so 'tailwind' alone asks for nothing more. The rule is stated once in colab-v1.md, 'Page runtime'; the app's parent detection and the native standalone export both test against this file.",
  "cases": [
    {
      "name": "react alone",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"react\">",
      "wantsReact": true
    },
    {
      "name": "tailwind alone asks for no React (every page has Tailwind)",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"tailwind\">",
      "wantsReact": false
    },
    {
      "name": "both tokens",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"react tailwind\">",
      "wantsReact": true
    },
    {
      "name": "extra ASCII whitespace around tokens",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"  tailwind \t\n react \">",
      "wantsReact": true
    },
    {
      "name": "a tab is the only separator",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"x\treact\">",
      "wantsReact": true
    },
    {
      "name": "a line feed is the only separator",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"x\nreact\">",
      "wantsReact": true
    },
    {
      "name": "a form feed is the only separator",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"x\freact\">",
      "wantsReact": true
    },
    {
      "name": "a known token among unknown ones",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"react unknown-part\">",
      "wantsReact": true
    },
    {
      "name": "unknown token first, known second",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"unknown-part react\">",
      "wantsReact": true
    },
    {
      "name": "single-quoted attributes in the other order",
      "source": "<meta content='react' name='tmt-colab-runtime'>",
      "wantsReact": true
    },
    {
      "name": "unquoted attribute values",
      "source": "<meta name=tmt-colab-runtime content=react>",
      "wantsReact": true
    },
    {
      "name": "attribute names are case-insensitive",
      "source": "<meta NAME=\"tmt-colab-runtime\" CONTENT=\"react\">",
      "wantsReact": true
    },
    {
      "name": "inside a full document head",
      "source": "<!doctype html><html><head><title>t</title><meta name=\"tmt-colab-runtime\" content=\"react\"></head><body><p>x</p></body></html>",
      "wantsReact": true
    },
    {
      "name": "in the body, tailwind alone",
      "source": "<p>x</p><meta name=\"tmt-colab-runtime\" content=\"tailwind\">",
      "wantsReact": false
    },
    {
      "name": "the first marker decides: unknown, then react",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"unknown-part\"><meta name=\"tmt-colab-runtime\" content=\"react\">",
      "wantsReact": false
    },
    {
      "name": "the first marker decides: empty, then react",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"\"><meta name=\"tmt-colab-runtime\" content=\"react\">",
      "wantsReact": false
    },
    {
      "name": "the first marker decides: react, then empty",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"react\"><meta name=\"tmt-colab-runtime\" content=\"\">",
      "wantsReact": true
    },
    {
      "name": "no marker",
      "source": "<p>Plain page</p>",
      "wantsReact": false
    },
    {
      "name": "empty content",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"\">",
      "wantsReact": false
    },
    {
      "name": "only unknown tokens",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"unknown-part\">",
      "wantsReact": false
    },
    {
      "name": "token values are case-sensitive",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"REACT\">",
      "wantsReact": false
    },
    {
      "name": "the marker name is case-sensitive",
      "source": "<meta name=\"TMT-COLAB-RUNTIME\" content=\"react\">",
      "wantsReact": false
    },
    {
      "name": "a longer name is not the marker",
      "source": "<meta name=\"tmt-colab-runtime-extra\" content=\"react\">",
      "wantsReact": false
    },
    {
      "name": "another meta name",
      "source": "<meta name=\"other\" content=\"react\">",
      "wantsReact": false
    },
    {
      "name": "no content attribute",
      "source": "<meta name=\"tmt-colab-runtime\">",
      "wantsReact": false
    },
    {
      "name": "non-ASCII whitespace does not separate tokens",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"react tailwind\">",
      "wantsReact": false
    },
    {
      "name": "a token with a prefix is not the token",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"reactive\">",
      "wantsReact": false
    },
    {
      "name": "text that only mentions the marker",
      "source": "<p>tmt-colab-runtime react</p>",
      "wantsReact": false
    },
    {
      "name": "inside an HTML comment",
      "source": "<!-- <meta name=\"tmt-colab-runtime\" content=\"react\"> -->",
      "wantsReact": false
    },
    {
      "name": "inside a textarea",
      "source": "<textarea><meta name=\"tmt-colab-runtime\" content=\"react\"></textarea>",
      "wantsReact": false
    },
    {
      "name": "inside a script string",
      "source": "<script>var m = '<meta name=\"tmt-colab-runtime\" content=\"react\">'</script>",
      "wantsReact": false
    },
    {
      "name": "a tailwind marker after a commented-out react marker",
      "source": "<!-- <meta name=\"tmt-colab-runtime\" content=\"react\"> --><meta name=\"tmt-colab-runtime\" content=\"tailwind\">",
      "wantsReact": false
    },
    {
      "name": "inside a title",
      "source": "<title><meta name=\"tmt-colab-runtime\" content=\"react\"></title>",
      "wantsReact": false
    },
    {
      "name": "inside a template",
      "source": "<template><meta name=\"tmt-colab-runtime\" content=\"react\"></template>",
      "wantsReact": false
    },
    {
      "name": "inside a noscript, which is markup when scripting is off",
      "source": "<noscript><meta name=\"tmt-colab-runtime\" content=\"react\"></noscript>",
      "wantsReact": true
    },
    {
      "name": "inside a style element",
      "source": "<style>/* <meta name=\"tmt-colab-runtime\" content=\"react\"> */</style>",
      "wantsReact": false
    },
    {
      "name": "a template copy does not shadow a real marker after it",
      "source": "<template><meta name=\"tmt-colab-runtime\" content=\"unknown-part\"></template><meta name=\"tmt-colab-runtime\" content=\"react\">",
      "wantsReact": true
    },
    {
      "name": "tab and newline separate tokens",
      "source": "<meta name=\"tmt-colab-runtime\" content=\"unknown-part\treact\">",
      "wantsReact": true
    }
  ]
}
