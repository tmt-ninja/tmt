    "objectId": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "authorDevice": "20000000-0000-4000-8000-000000000093",
    "membershipRevision": "1",
